    {
      "type": "text",
      "version": 1,
      "versionNonce": 161891894,
      "isDeleted": false,
      "id": "hi-subtitle-cmtpzpmcn465909adazd13ro1",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 0,
      "y": 100,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "width": 2566.40625,
