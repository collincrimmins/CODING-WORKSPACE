      "seed": 48178904.90860455,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1788709933575,
      "link": null,
      "locked": true,
      "fontSize": 30,
      "fontFamily": 3,
      "text": "Robinhood is a commission-free trading platform for stocks, ETFs, options, and cryptocurrencies. It features real-time market data and basic order\nmanagement. Robinhood isn't an exchange in its own right, but rather a stock broker; it routes trades through market makers\n(\"exchanges\") and is compensated by those exchanges via a process called \"payment for order flow\".",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Robinhood is a commission-free trading platform for stocks, ETFs, options, and cryptocurrencies. It features real-time market data and basic order\nmanagement. Robinhood isn't an exchange in its own right, but rather a stock broker; it routes trades through market makers\n(\"exchanges\") and is compensated by those exchanges via a process called \"payment for order flow\".",
      "lineHeight": 1.25,
      "baseline": 104
    },
