      "text": "// view price history for product\nGET /products/:productId/prices?granularly={daily}&period={1Y}\n-> List<Price>\n\n// subscribe to price drop notification w /threshold\nPOST /subscriptions\nbody {\n    productId: string,\n    threshold: number,\n    notificationType: \"email\" | \"text\"\n}\nheader {JWT}",
