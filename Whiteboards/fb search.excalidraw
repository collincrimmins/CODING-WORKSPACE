      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Create Post\nPOST /posts\nheader {JWTToken}\nbody {text}\n-> success or fail\n\n// Like Post\nPOST /likes/:postid\nbody {\n    \"like\": true | false\n}\n-> void\n\n// Search Post\nGET /posts/search?keyword={}&sort={\"recent\" | \"likes\"}&pageNum={}&cursor={}\n-> {\n    Posts[],\n    lastPostCursor\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Create Post\nPOST /posts\nheader {JWTToken}\nbody {text}\n-> success or fail\n\n// Like Post\nPOST /likes/:postid\nbody {\n    \"like\": true | false\n}\n-> void\n\n// Search Post\nGET /posts/search?keyword={}&sort={\"recent\" | \"likes\"}&pageNum={}&cursor={}\n-> {\n    Posts[],\n    lastPostCursor\n}",
      "lineHeight": 1.2,
      "baseline": 451
    },
