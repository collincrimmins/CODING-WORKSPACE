      "updated": 1787537762977,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "Search for businesses by name, location, cateogry\nGET /businesses?query={text}&lat={lat}&long={long}&category={category}&page={number} \n    -> List[] Businesses\n\nView Business Details\nGET /businesses/:businessid \n    -> BusinessObject {name, desc, location, review total score}\n\nView Business Reviews (by Page)\nGET /businesses/:businessid/reviews?page={number}\n    > List[] ReviewObject\n\nSubmit User Review\nPOST /businesses/:businessid/review\nbody { rating, contentText }\n    -> ResponseObject {myreview, success | error}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Search for businesses by name, location, cateogry\nGET /businesses?query={text}&lat={lat}&long={long}&category={category}&page={number} \n    -> List[] Businesses\n\nView Business Details\nGET /businesses/:businessid \n    -> BusinessObject {name, desc, location, review total score}\n\nView Business Reviews (by Page)\nGET /businesses/:businessid/reviews?page={number}\n    > List[] ReviewObject\n\nSubmit User Review\nPOST /businesses/:businessid/review\nbody { rating, contentText }\n    -> ResponseObject {myreview, success | error}",
      "lineHeight": 1.2,
      "baseline": 379,
      "index": "aQ",
      "autoResize": true
    },
