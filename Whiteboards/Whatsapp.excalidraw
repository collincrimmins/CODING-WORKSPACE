      "link": null,
      "locked": true,
      "fontSize": 30,
      "fontFamily": 3,
      "text": "Whatsapp is a messaging service that allows users to send and receive encrypted messages and calls from their phones and\ncomputers. Whatsapp was famously originally built on Erlang (no longer!) and renowned for handling high scale with limited engineering and\ninfrastructure outlay.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Whatsapp is a messaging service that allows users to send and receive encrypted messages and calls from their phones and\ncomputers. Whatsapp was famously originally built on Erlang (no longer!) and renowned for handling high scale with limited engineering and\ninfrastructure outlay.",
      "lineHeight": 1.25,
      "baseline": 104,
      "index": "a1",
      "autoResize": true
    },
