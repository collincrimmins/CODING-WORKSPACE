      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Send Message in Chat (User or Group)\nPOST /chats/{groupid}\nheaders {JWT}\nbody {\n    chatId: \"\",\n    text: \"\",\n    attachments:[]\n}\n-> result {success | fail}\n\n// Create Chat (User or Group)\nPOST /chats\nbody {\n    userIds: {}\n}\n-> result {\n    chatId: \"\"\n}\n\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Send Message in Chat (User or Group)\nPOST /chats/{groupid}\nheaders {JWT}\nbody {\n    chatId: \"\",\n    text: \"\",\n    attachments:[]\n}\n-> result {success | fail}\n\n// Create Chat (User or Group)\nPOST /chats\nbody {\n    userIds: {}\n}\n-> result {\n    chatId: \"\"\n}\n\n",
      "lineHeight": 1.2,
      "baseline": 475,
      "index": "aO",
      "autoResize": true
    },
