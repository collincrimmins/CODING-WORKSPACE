      "boundElements": [],
      "updated": 1788013103738,
      "link": null,
      "locked": true,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "1. Users should be able to start group chats with multiple participants (limit 100).\n2. Users should be able to send/receive messages.\n3. Users should be able to receive messages sent while they are not online (up to\n30 days).\n4. Users should be able to send/receive media in their messages.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Users should be able to start group chats with multiple participants (limit 100).\n2. Users should be able to send/receive messages.\n3. Users should be able to receive messages sent while they are not online (up to\n30 days).\n4. Users should be able to send/receive media in their messages.",
      "lineHeight": 1.25,
      "baseline": 119,
      "index": "a8",
      "autoResize": true
    },
