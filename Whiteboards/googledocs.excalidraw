      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Create New Document\nPOST /docs\n{\n  title: string\n} -> {\n  docId\n}\n\n// Websockets\nWS /docs/{docId}\n  SEND {\n    type: \"insert\"\n    ....\n  }\n\n  SEND {\n    type: \"updateCursor\"\n    position: ...\n  }\n\n  SEND { \n    type: \"delete\"\n    ...\n  }\n\n  RECV { \n    type: \"update\"\n    ...\n  }",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Create New Document\nPOST /docs\n{\n  title: string\n} -> {\n  docId\n}\n\n// Websockets\nWS /docs/{docId}\n  SEND {\n    type: \"insert\"\n    ....\n  }\n\n  SEND {\n    type: \"updateCursor\"\n    position: ...\n  }\n\n  SEND { \n    type: \"delete\"\n    ...\n  }\n\n  RECV { \n    type: \"update\"\n    ...\n  }",
      "lineHeight": 1.2,
      "baseline": 691
    },
