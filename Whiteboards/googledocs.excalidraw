      "boundElements": [],
      "updated": 1788715133110,
      "link": null,
      "locked": true,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "1. Users should be able to create new documents.\n2. Multiple users (limit 100) should be able to edit the same document concurrently.\n3. Users should be able to view each other's changes in real-time.\n4. Users should be able to see the cursor position and presence of other users.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Users should be able to create new documents.\n2. Multiple users (limit 100) should be able to edit the same document concurrently.\n3. Users should be able to view each other's changes in real-time.\n4. Users should be able to see the cursor position and presence of other users.",
      "lineHeight": 1.25,
      "baseline": 94
    },
