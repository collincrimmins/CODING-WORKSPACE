      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Merchant initiates payment request\nPOST /paymentIntent\nbody {amountInCents: \"2499\", currency: \"usd\", description: \"Order 1234\"}\n-> paymentIntentId\n\n// Pay for products with credit/debit cards\nPOST /paymentIntent/:paymentIntendId/transactions\nbody {\n    type: \"credit\",\n    card: {number: \"1234\", exp:\"12/8\", ...}\n}\n-> 201\n\n// Check payment status\nGET /paymentIntent/:paymentIntendId\n-> paymentIntend",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Merchant initiates payment request\nPOST /paymentIntent\nbody {amountInCents: \"2499\", currency: \"usd\", description: \"Order 1234\"}\n-> paymentIntentId\n\n// Pay for products with credit/debit cards\nPOST /paymentIntent/:paymentIntendId/transactions\nbody {\n    type: \"credit\",\n    card: {number: \"1234\", exp:\"12/8\", ...}\n}\n-> 201\n\n// Check payment status\nGET /paymentIntent/:paymentIntendId\n-> paymentIntend",
