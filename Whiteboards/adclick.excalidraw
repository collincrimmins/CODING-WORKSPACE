      "link": null,
      "locked": true,
      "fontSize": 30,
      "fontFamily": 3,
      "text": "An Ad Click Aggregator is a system that collects and aggregates data on ad clicks. It is used by advertisers\nto track the performance of their ads and optimize their campaigns. For our purposes, we will assume these are ads\ndisplayed on a website or app, like Facebook.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Ad Click Aggregator is a system that collects and aggregates data on ad clicks. It is used by advertisers\nto track the performance of their ads and optimize their campaigns. For our purposes, we will assume these are ads\ndisplayed on a website or app, like Facebook.",
      "lineHeight": 1.25,
      "baseline": 104
    },
