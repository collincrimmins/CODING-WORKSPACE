    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 1596336760,
      "isDeleted": false,
      "id": "hi-subtitle-cmtnedv9d28gz08ad2ugl5gdk",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 0,
      "y": 100,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "width": 2654.296875,
