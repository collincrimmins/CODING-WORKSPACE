      "seed": 827689636.2409918,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1788553182737,
      "link": null,
      "locked": true,
      "fontSize": 30,
      "fontFamily": 3,
      "text": "An internal notification platform that other engineering teams use to send messages to users across push, email, and SMS. The\nsame pipeline carries low-volume, latency-sensitive traffic like login codes alongside million-user marketing campaigns, and the design has to keep the\nbulk traffic from trampling the critical traffic.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An internal notification platform that other engineering teams use to send messages to users across push, email, and SMS. The\nsame pipeline carries low-volume, latency-sensitive traffic like login codes alongside million-user marketing campaigns, and the design has to keep the\nbulk traffic from trampling the critical traffic.",
      "lineHeight": 1.25,
      "baseline": 104
    },
