    {
      "type": "text",
      "version": 1,
      "versionNonce": 1393028216,
      "isDeleted": false,
      "id": "hi-cmtnedv9e28h408ad4zvc35v1",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
