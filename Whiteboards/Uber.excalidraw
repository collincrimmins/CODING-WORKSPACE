      "link": null,
      "locked": true,
      "fontSize": 30,
      "fontFamily": 3,
      "text": "Uber is a ride-sharing platform that connects passengers with drivers who offer transportation services in personal vehicles. It allows users\nto book rides on-demand from their smartphones, matching them with a nearby driver who will take them from their location\nto their desired destination. When the system finds a match, it sends an update to the driver asking them to\naccept or decline the ride.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uber is a ride-sharing platform that connects passengers with drivers who offer transportation services in personal vehicles. It allows users\nto book rides on-demand from their smartphones, matching them with a nearby driver who will take them from their location\nto their desired destination. When the system finds a match, it sends an update to the driver asking them to\naccept or decline the ride.",
      "lineHeight": 1.25,
      "baseline": 141,
      "index": "a1",
      "autoResize": true
    },
