      "updated": 1787509256433,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "Get Ride Estimate (Based on available rivers, ride start and end, and num passengers)\n(Do not pass my userid in body, the server will get my userid from my JWT token)\nPOST /rides/fare-estimate\n    body {startLocation, endLocation, numpassengers}\n       -> fareObject {fareId}\n\nUser: Initial Request to claim a Driver & create a ride\nPOST /rides\n    body {startLocation, endLocation, numpassengers, fareId}\n        -> rideObject {status = pending or accepted or rejected}\n\nDriver: Accept or Reject user's ride request\nPATCH /rides/driver/:rideid\n    body {status = accepted or rejected}\n        -> rideObject {status = activeRide or error}\n\nUpdate Location\nPOST /drivers/location \n    body {latitude, longitude} \n        -> void",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Get Ride Estimate (Based on available rivers, ride start and end, and num passengers)\n(Do not pass my userid in body, the server will get my userid from my JWT token)\nPOST /rides/fare-estimate\n    body {startLocation, endLocation, numpassengers}\n       -> fareObject {fareId}\n\nUser: Initial Request to claim a Driver & create a ride\nPOST /rides\n    body {startLocation, endLocation, numpassengers, fareId}\n        -> rideObject {status = pending or accepted or rejected}\n\nDriver: Accept or Reject user's ride request\nPATCH /rides/driver/:rideid\n    body {status = accepted or rejected}\n        -> rideObject {status = activeRide or error}\n\nUpdate Location\nPOST /drivers/location \n    body {latitude, longitude} \n        -> void",
      "lineHeight": 1.2,
      "baseline": 475,
      "index": "aO",
      "autoResize": true
    },
