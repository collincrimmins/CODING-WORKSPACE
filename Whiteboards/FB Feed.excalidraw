      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Follow a user (PUT is idempotent) (my Auth is stored in my JWT Token in the Headers)\nPUT /users/{userid}/followers \n-> Response {success/fail}\n\n// Create Post\nPOST /posts body {text}\n-> Post\n\n// Get Timeline Chronological Feed w/ Pagination (use last post as chronological cursor)\nGET /posts?cursor={lastPostTimestamp}&pageSize={pageSize} \n-> Response {\n    Posts[],\n    nextCursorTimestamp\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Follow a user (PUT is idempotent) (my Auth is stored in my JWT Token in the Headers)\nPUT /users/{userid}/followers \n-> Response {success/fail}\n\n// Create Post\nPOST /posts body {text}\n-> Post\n\n// Get Timeline Chronological Feed w/ Pagination (use last post as chronological cursor)\nGET /posts?cursor={lastPostTimestamp}&pageSize={pageSize} \n-> Response {\n    Posts[],\n    nextCursorTimestamp\n}",
      "lineHeight": 1.2,
      "baseline": 331,
      "index": "aO",
      "autoResize": true
    },
