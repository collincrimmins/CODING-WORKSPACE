      "link": null,
      "locked": true,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "1. Users should be able to create posts\n2. Users should be able to friend/follow people (these are uni-directional follow relationships)\n3. Users should be able to view a feed of posts from people they follow, in\nchronological order\n4. Users should be able to page through their feed",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Users should be able to create posts\n2. Users should be able to friend/follow people (these are uni-directional follow relationships)\n3. Users should be able to view a feed of posts from people they follow, in\nchronological order\n4. Users should be able to page through their feed",
      "lineHeight": 1.25,
      "baseline": 119,
      "index": "a8",
      "autoResize": true
    },
