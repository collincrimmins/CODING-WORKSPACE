      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Get my Feed\nGET /feed?lat={lat}&long={long}&distance={num}\n-> Users[]\n\n// Update my Profile\nPOST /users/profile\nheaders {JWTToken}\nbody {\n    name: {},\n    bio: {},\n    age: {},\n    location: {},\n    ageRange: {}\n}\n\n// Set Swipe Result\nPOST /swipes/{targetUserId}\nheaders {JWTToken}\nbody {liked: true | false}\n-> Response {match: true | false}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Get my Feed\nGET /feed?lat={lat}&long={long}&distance={num}\n-> Users[]\n\n// Update my Profile\nPOST /users/profile\nheaders {JWTToken}\nbody {\n    name: {},\n    bio: {},\n    age: {},\n    location: {},\n    ageRange: {}\n}\n\n// Set Swipe Result\nPOST /swipes/{targetUserId}\nheaders {JWTToken}\nbody {liked: true | false}\n-> Response {match: true | false}",
      "lineHeight": 1.2,
      "baseline": 475,
      "index": "aO",
      "autoResize": true
