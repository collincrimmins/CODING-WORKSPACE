    {
      "type": "text",
      "version": 2,
      "versionNonce": 698101155,
      "isDeleted": false,
      "id": "hi-cmtairyfc4s6708ad8zyb9bor",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
