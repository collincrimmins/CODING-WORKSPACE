      "boundElements": [],
      "updated": 1787776357798,
      "link": null,
      "locked": true,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "1. Users can create a profile with preferences (e.g. age range, interests) and specify a maximum\ndistance.\n2. Users can view a stack of potential matches in line with their preferences and within\nmax distance of their current location.\n3. Users can swipe right / left on profiles one-by-one, to express 'yes' or 'no' on\nother users.\n4. Users get a match notification if they mutually swipe on each other.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Users can create a profile with preferences (e.g. age range, interests) and specify a maximum\ndistance.\n2. Users can view a stack of potential matches in line with their preferences and within\nmax distance of their current location.\n3. Users can swipe right / left on profiles one-by-one, to express 'yes' or 'no' on\nother users.\n4. Users get a match notification if they mutually swipe on each other.",
      "lineHeight": 1.25,
      "baseline": 169,
      "index": "a8",
      "autoResize": true
    },
