      "fontSize": 30,
      "fontFamily": 3,
      "text": "Google News is a digital service that aggregates and displays news articles from thousands of publishers worldwide in a scrollable\ninterface for users to stay updated on current events.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Google News is a digital service that aggregates and displays news articles from thousands of publishers worldwide in a scrollable\ninterface for users to stay updated on current events.",
