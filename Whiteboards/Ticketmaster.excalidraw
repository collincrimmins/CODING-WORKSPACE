      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Details Page for 1 Event\nGET /events/:eventid -> Event\n\n// Search All Events\nGET /events?search={searchtext}&start={date}&end={date}&minPrice={price}&maxPrice={price}\n    &page={number}&pageSize={number} -> List<Events>\n\n// Reserve Ticket during Checkout\nPOST /tickets/:ticketid { reserve: true} -> Response Object\n\n// Book Ticket\nPOST /tickets/:ticketid \nbody { finalcheckout: true, paymentInformation: {...} } \n-> Response Object",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Details Page for 1 Event\nGET /events/:eventid -> Event\n\n// Search All Events\nGET /events?search={searchtext}&start={date}&end={date}&minPrice={price}&maxPrice={price}\n    &page={number}&pageSize={number} -> List<Events>\n\n// Reserve Ticket during Checkout\nPOST /tickets/:ticketid { reserve: true} -> Response Object\n\n// Book Ticket\nPOST /tickets/:ticketid \nbody { finalcheckout: true, paymentInformation: {...} } \n-> Response Object",
      "lineHeight": 1.2,
      "baseline": 331,
      "index": "aO",
      "autoResize": true
    },
