    {
      "id": "FIK4EofYtnRTythKvMMxK",
      "type": "text",
      "x": 93.80001831054688,
      "y": -723.6999206542969,
      "width": 633.4192504882812,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
