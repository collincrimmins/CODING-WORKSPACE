      "fontSize": 30,
      "fontFamily": 3,
      "text": "Design a system that ingests a global firehose of YouTube view events and serves precise top-K video leaderboards for multiple\ntime windows (last hour, last day, last month, all-time).",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design a system that ingests a global firehose of YouTube view events and serves precise top-K video leaderboards for multiple\ntime windows (last hour, last day, last month, all-time).",
      "lineHeight": 1.25,
      "baseline": 66
