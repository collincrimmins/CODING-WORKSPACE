      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Create Auction\nPOST /auction\nbody {itemName: \"\", startingPrice: {number}, endDate: {date}}\n-> Auction {id, ...}\n\n// View Auction\nGET /auction/:id\n-> {\n    itemName: \"\",\n    highestBid: {number},\n    endDate: {date}\n}\n\n// Attempt bid on an item (rejected if not the highest bid)\nPOST /auction/:id/bids\nbody {myBid: {number}}\n-> success | fail",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Create Auction\nPOST /auction\nbody {itemName: \"\", startingPrice: {number}, endDate: {date}}\n-> Auction {id, ...}\n\n// View Auction\nGET /auction/:id\n-> {\n    itemName: \"\",\n    highestBid: {number},\n    endDate: {date}\n}\n\n// Attempt bid on an item (rejected if not the highest bid)\nPOST /auction/:id/bids\nbody {myBid: {number}}\n-> success | fail",
      "lineHeight": 1.2,
      "baseline": 403
    },
