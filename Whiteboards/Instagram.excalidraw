      "versionNonce": 1011778566,
      "isDeleted": false,
      "id": "68JzZexWyaXKK83FEtKWY",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 64.19283261255043,
      "y": 1727.9623842733704,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 902.34375,
