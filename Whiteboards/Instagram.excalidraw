      "roundness": null,
      "boundElements": [],
      "updated": 1787620127980,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Follow a user\n// Server will use my JWT Token in the Header to figure out what my UserID is\nPOST /users/{userid}/follow \n-> void\n\n// Create Post (user will receive presigned URL to upload to s3 storge)\nPOST /posts\nbody {text}\n-> ResponseObject {presignedS3uploadUrl}\n\n// Get Feed w/ pagination\nGET /posts?lastCursor={timestamp}&pageSize={number}\n-> Posts[]",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Follow a user\n// Server will use my JWT Token in the Header to figure out what my UserID is\nPOST /users/{userid}/follow \n-> void\n\n// Create Post (user will receive presigned URL to upload to s3 storge)\nPOST /posts\nbody {text}\n-> ResponseObject {presignedS3uploadUrl}\n\n// Get Feed w/ pagination\nGET /posts?lastCursor={timestamp}&pageSize={number}\n-> Posts[]",
      "lineHeight": 1.2,
      "baseline": 307,
      "index": "aO",
      "autoResize": true
    },
