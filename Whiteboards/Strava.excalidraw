      "updated": 1787951105593,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "// Create New Activity (which is a Ride or a Run) - my UserId is in the JWT Token \nPOST /activity\nheader {JWT}\nbody {type: \"run\" | \"ride\"}\n-> activityId\n\n// Update Activity (route progress or end activity)\nPATCH /activity/{activityId}\nbody {\n    routeInfo: {lat, long}\n    time: \"\"\n    state: \"active\" | \"completed\" | \"paused\" | \"resumed\"\n}\n- success or fail\n\n// Get Activity Info (either active or completed activity, or me or my friends id)\nGET /activity/{activityId}\n-> Activity {activityType: \"\", route: [], time: \"\"}\n\n// Get Paginated List of Activities (Me or my friend)\nGET /activity/{userId}?page={}&cursor={}\n-> PageResponse<List<Activity>>\n\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Create New Activity (which is a Ride or a Run) - my UserId is in the JWT Token \nPOST /activity\nheader {JWT}\nbody {type: \"run\" | \"ride\"}\n-> activityId\n\n// Update Activity (route progress or end activity)\nPATCH /activity/{activityId}\nbody {\n    routeInfo: {lat, long}\n    time: \"\"\n    state: \"active\" | \"completed\" | \"paused\" | \"resumed\"\n}\n- success or fail\n\n// Get Activity Info (either active or completed activity, or me or my friends id)\nGET /activity/{activityId}\n-> Activity {activityType: \"\", route: [], time: \"\"}\n\n// Get Paginated List of Activities (Me or my friend)\nGET /activity/{userId}?page={}&cursor={}\n-> PageResponse<List<Activity>>\n\n",
      "lineHeight": 1.2,
      "baseline": 571
    },
